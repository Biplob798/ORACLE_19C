  CREATE TABLE "USERS_AUTH" 
   (	"ID" NUMBER, 
	"FIRST_NAME" VARCHAR2(40), 
	"LAST_NAME" VARCHAR2(40), 
	"LOGIN_ID" VARCHAR2(40), 
	"PASSWORD_HASH" VARCHAR2(200), 
	"ACTIVE_STATUS" CHAR(1) DEFAULT 'Y', 
	"ACTION_USER" VARCHAR2(100), 
	"ACTION_DATE_TIME" DATE DEFAULT SYSDATE, 
	"ROLE_NAME" VARCHAR2(20) DEFAULT 'USER', 
	 PRIMARY KEY ("ID")
  USING INDEX  ENABLE
   ) ;

  CREATE OR REPLACE EDITIONABLE TRIGGER "TRG_USERS_AUTH_ID" 
BEFORE INSERT ON USERS_AUTH
FOR EACH ROW
BEGIN
  IF :NEW.ID IS NULL THEN
    SELECT NVL(MAX(ID), 0) + 1 INTO :NEW.ID FROM USERS_AUTH;
  END IF;
END;
